{
  "name": "SuperAppShowcase",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/Xung-Chan/Super-App-Showcase.git",
  "author": "Nguyễn Mai Duy Trường <115866921+Xung-Chan@users.noreply.github.com>",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run start --parallel --continue",
    "dev:host": "yarn workspace host_app start",
    "dev:mini-a": "yarn workspace mini_app_a start",
    "dev:mini-b": "yarn workspace mini_app_b start",
    "build:android":"yarn workspace host_app run android",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{js,ts,tsx,json}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "2.7.5"
  },
  "packageManager": "yarn@4.11.0",
  "dependencies": {
    "@react-native-masked-view/masked-view": "^0.3.2"
  }
}
